# Public application URL
APP_URL=http://localhost:5173

# Keep existing local providers until external accounts are configured.
LIBRARY_DATABASE=d1
ORIGINAL_STORAGE=binding
SUPABASE_URL=
SUPABASE_SECRET_KEY=
CF_IMAGES_ENABLED=false
CF_IMAGES_ACCOUNT_ID=
CF_IMAGES_API_TOKEN=
CF_IMAGES_THUMBNAIL_VARIANT=thumbnail

# Supabase (server and browser safe anon key only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (server only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=wedding-originals

# Cloudflare image delivery
NEXT_PUBLIC_IMAGE_CDN_BASE_URL=
CF_IMAGE_ACCOUNT_HASH=
CF_IMAGE_SIGNING_KEY=

# Session/password protection
AUTH_SECRET=
WEDDING_ACCESS_PEPPER=

# Safe rollout: legacy remains active until Worker/buckets/CORS are verified.
IMAGE_PIPELINE=legacy
R2_ORIGINALS_BUCKET=wedding-originals
R2_PREVIEWS_BUCKET=wedding-previews
IMAGE_DELIVERY_DOMAIN=
IMAGE_WORKER_SECRET=
