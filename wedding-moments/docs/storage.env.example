# Copy VALUES into server-side runtime secrets. Never commit a filled copy.
# Enable these providers only after creating the resources and applying SQL.
LIBRARY_DATABASE=supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=
# Legacy alternative: SUPABASE_SERVICE_ROLE_KEY=

ORIGINAL_STORAGE=s3
R2_ACCOUNT_ID=
R2_BUCKET_NAME=wedding-originals
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

CF_IMAGES_ENABLED=true
CF_IMAGES_ACCOUNT_ID=
CF_IMAGES_API_TOKEN=
CF_IMAGE_ACCOUNT_HASH=
CF_IMAGE_SIGNING_KEY=
CF_IMAGES_THUMBNAIL_VARIANT=thumbnail
